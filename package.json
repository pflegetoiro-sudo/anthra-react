    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.40",
    "autoprefixer": "^10.4.19",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17"
